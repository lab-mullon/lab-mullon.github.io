Cell[CellGroupData[{

Cell["Exercise 7: coordinated hunting under limited dispersal", "Section",ExpressionUUID->"159bd816-5f4b-4cd6-b082-08806a7b2d01"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 CellLabel->
  "In[1771]:=",ExpressionUUID->"d0ea05ea-6e39-4e15-b412-5e0fb52639c2"],

Cell[CellGroupData[{

Cell["a. Individual fitness", "Subsection",ExpressionUUID->"c941529c-6e12-4f6f-88b1-3f7243b0fbc7"],

Cell["\<\
The patch life cycle and relatedness are unchanged from exercise 6. We only \
replace the payoff, then recompute fecundity and individual fitness.\
\>", "Text",ExpressionUUID->"34da2caa-e899-42db-b040-29d104700513"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{"zi_", ",", "zj_"}], "]"}], " ", ":=", " ", 
   RowBox[{"1", " ", "-", " ", "zi", " ", "+", " ", 
