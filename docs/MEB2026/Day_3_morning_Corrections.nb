Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"relatednessEquation", " ", "=", " ", 
   RowBox[{"r2", " ", "==", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"s", "^", "2"}], " ", "r2"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", " ", 
       RowBox[{
        RowBox[{"2", " ", "s", " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "s"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "m"}], ")"}]}], " ", "+", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "s"}], ")"}], "^", "2"}], " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "m"}], ")"}], "^", "2"}]}]}], " ", 
       ")"}], " ", 
      RowBox[{"(", 
