 RowBox[{
  RowBox[{"w", " ", "=", " ", 
   RowBox[{"s", " ", "+", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "s"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", " ", "-", " ", "m"}], ")"}], " ", "fF"}], 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", " ", "-", " ", "m"}], ")"}], " ", "fBar"}], " ", "+", 
         " ", 
         RowBox[{"m", " ", "fResident", " "}]}]], "+", "  ", 
       FractionBox[
        RowBox[{"m", " ", "fF"}], "fResident"]}], " ", ")"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.99708436716579*^9, 3.997084391586952*^9}},
 CellLabel->
  "In[1772]:=",ExpressionUUID->"a79006f6-6a1b-48b5-8b93-3b2e35607e4f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"residentCheck", " ", "=", " ", "FullSimplify", "[", "w", " ", "/.", 
  " ", "{", "zF", " ", "->", " ", "x", ",", " ", "z1", " ", "->", " ", "x", 
  "}", "]", ";"}], "\[IndentingNewLine]", "residentCheck"}], "Input",
 CellLabel->
  "In[1783]:=",ExpressionUUID->"25415506-519b-46aa-8092-a8523b562e6b"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{{3.997084383803735*^9, 3.9970843930904083`*^9}, 
   3.997084591177109*^9, 3.997084753685979*^9},
 CellLabel->
  "Out[1784]=",ExpressionUUID->"7147430a-2332-4e61-ae2e-231dbe32552a"]
}, Open  ]],

Cell["\<\
At the resident state, all individuals have the same fecundity and individual \
fitness equals one.\
\>", "Text",ExpressionUUID->"bad58983-3007-4bcd-b947-88e102e951a4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["b. Selection from individual fitness", "Subsection",ExpressionUUID->"e1197bd6-aaeb-4d2a-a228-0639a55d887d"],

Cell["\<\
As in exercise 6, start from the inclusive-fitness selection gradient.\
\>", "Text",ExpressionUUID->"07896e1d-2165-4cc1-9342-196043f47cdc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"r2Expr", "=", 
   FractionBox[
    RowBox[{
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "m"}], ")"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "-", "s"}], ")"}], "2"]}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "m"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"1", "-", "s"}], ")"}], " ", "s"}]}], 
    RowBox[{"n", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["s", "2"], "-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", "m"}], ")"}], "2"], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", "s"}], ")"}], "2"]}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "m"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", "s"}], ")"}], " ", "s"}]}], ")"}]}], "n"]}], 
      ")"}]}]]}], " ", ";"}]], "Input",
 CellChangeTimes->{{3.9970845008334846`*^9, 3.997084505812458*^9}},
 CellLabel->
  "In[1785]:=",ExpressionUUID->"3c61c858-66fd-4e1d-aa5f-81676ba8f94a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"S", " ", "=", " ", "(", "D", "[", "w", ",", " ", "zF", "]", " ", 
  "+", " ", "(", "n", " ", "-", " ", "1", ")", " ", "r2Expr", " ", "D", "[", 
  "w", ",", " ", "z1", "]", ")", " ", "/.", " ", "{", "zF", " ", "->", " ", 
  "x", ",", " ", "z1", " ", "->", " ", "x", "}", " ", "//", " ", "Simplify", 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Sscaled", " ", "=", " ", 
  RowBox[{
   RowBox[{"%", " ", "*", " ", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", " ", "x"}], "]"}], " ", "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "s"}], ")"}]}]}], " ", "//", " ", 
   "Simplify", " "}]}]}], "Input",
 CellChangeTimes->{{3.9970843975691977`*^9, 3.997084419048189*^9}, {
  3.99708446169738*^9, 3.997084462146042*^9}},
 CellLabel->
  "In[1786]:=",ExpressionUUID->"aeebdc06-be33-4bd6-8bf6-e25a730eed3c"],

Cell[BoxData[
 FractionBox[
  RowBox[{"m", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"n", " ", 
      RowBox[{"(", 
       RowBox[{"2", "+", 
        RowBox[{"m", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "s"}], ")"}]}]}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"2", " ", "x"}]}], ")"}]}], "+", 
     RowBox[{"2", " ", "s", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], "+", "m", "+", 
        RowBox[{"4", " ", "x"}], "-", 
        RowBox[{"4", " ", "m", " ", "x"}]}], ")"}]}]}], ")"}], " ", 
   "\[Delta]"}], 
  RowBox[{"1", "+", 
   RowBox[{"2", " ", "m", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}]}], "+", 
   RowBox[{
    SuperscriptBox["m", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "s"}], ")"}]}], "+", "s"}]]], "Output",
 CellChangeTimes->{3.997084470112858*^9, 3.997084508365033*^9, 
  3.9970845911976233`*^9, 3.9970847537056704`*^9},
 CellLabel->
  "Out[1787]=",ExpressionUUID->"03f2259c-d15b-496c-a6df-1e686be5a4cc"]
}, Open  ]],

Cell[BoxData[
 RowBox[{"\[Kappa]", " ", "=", " ", "2", " ", "s", " ", "(", "1", " ", "-", 
  " ", "m", ")", "/", "(", "n", " ", "(", "2", " ", "-", " ", "m", ")", " ", 
  "+", " ", "s", " ", "(", "2", " ", "+", " ", "(", "n", " ", "-", " ", "2", 
  ")", " ", "m", ")", ")", ";"}]], "Input",
 CellLabel->
  "In[1788]:=",ExpressionUUID->"9c5e454a-86d4-4fd8-bd53-2623660776cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{"Sscaled", " ", "==", " ", 
     RowBox[{"k", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], " ", "+", " ", 
          RowBox[{"2", " ", "x"}]}], ")"}], " ", "+", " ", 
        RowBox[{"\[Kappa]", " ", 
         RowBox[{"(", 
          RowBox[{"2", " ", "x"}], ")"}]}]}], ")"}]}]}], ",", " ", "k"}], 
   "]"}], " ", "//", " ", "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.9970844028648567`*^9, 3.9970844039444723`*^9}},
 CellLabel->
  "In[1789]:=",ExpressionUUID->"11a3b39a-505a-4158-95e7-8c406d50bf69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"k", "\[Rule]", 
    FractionBox[
     RowBox[{"m", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"n", " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"m", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "s"}], ")"}]}]}], ")"}]}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "m"}], ")"}], " ", "s"}]}], ")"}], " ", 
      "\[Delta]"}], 
     RowBox[{"1", "+", 
      RowBox[{"m", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"m", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "s"}], ")"}]}]}], ")"}]}], "+", "s"}]]}],
    "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.997084400675961*^9, 3.997084404489328*^9}, 
   3.997084512489792*^9, 3.997084591237651*^9, 3.997084753746017*^9},
 CellLabel->
  "Out[1789]=",ExpressionUUID->"51ff0d95-208b-4d6a-8302-45d5d854ca3a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"S", " ", "==", " ", 
   RowBox[{
    FractionBox[
     RowBox[{"m", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"n", " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"m", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"-", "1"}], "+", "s"}], ")"}]}]}], ")"}]}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", "1"}], "+", "m"}], ")"}], " ", "s"}]}], ")"}], " ", 
      "\[Delta]"}], 
     RowBox[{"1", "+", 
      RowBox[{"m", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "n"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"2", "+", 
         RowBox[{"m", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "s"}], ")"}]}]}], ")"}]}], "+", "s"}]], "  ", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", "s"}], ")"}], 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", " ", "x"}], "]"}], " "}]], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "1"}], " ", "+", " ", 
        RowBox[{"2", " ", "x"}]}], ")"}], " ", "+", " ", 
      RowBox[{"\[Kappa]", " ", 
       RowBox[{"(", 
        RowBox[{"2", " ", "x"}], ")"}]}]}], ")"}]}]}], " ", "//", " ", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.997084431410499*^9, 3.997084456952951*^9}, {
  3.997084546751666*^9, 3.997084567942892*^9}},
 CellLabel->
  "In[1790]:=",ExpressionUUID->"c104f332-8867-4751-a411-f398ab79cd20"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.997084547553665*^9, 3.9970845912475653`*^9}, 
   3.997084753755542*^9},
 CellLabel->
  "Out[1790]=",ExpressionUUID->"085f5c2b-cbf2-491a-988f-1a80c606a124"]
}, Open  ]],

Cell["\<\
The remaining factor is positive when \[Delta] > 0, 0 < m <= 1, s < 1 and \
resident fecundity is positive. The sign of selection is therefore the sign \
of (-1 + 2 x) + \[Kappa] (2 x).\
\>", "Text",ExpressionUUID->"3c11b085-d062-4c75-b400-856b624776f8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["c. The coordination threshold", "Subsection",ExpressionUUID->"b8f34752-bb3c-442b-90d1-dc73444acdf6"],

Cell[BoxData[
 RowBox[{"Sreduced", " ", "=", " ", "(", "-", "1", " ", "+", " ", "2", " ", 
  "x", ")", " ", "+", " ", "kappa", " ", "(", "2", " ", "x", ")", 
  ";"}]], "Input",
 CellLabel->
  "In[1791]:=",ExpressionUUID->"931785f9-0f4b-461c-a5c2-44cdc067f19e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"sing", " ", "=", " ", 
  RowBox[{"Flatten", "@", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"Sreduced", " ", "==", " ", "0"}], ",", " ", "x"}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{"J", " ", "=", " ", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{"Sreduced", ",", " ", "x"}], "]"}], " ", "//", " ", 
   "Simplify"}]}]}], "Input",
 CellChangeTimes->{{3.997084608742378*^9, 3.9970846093132067`*^9}},
 CellLabel->
  "In[1792]:=",ExpressionUUID->"30466fcd-fde0-403e-82fc-a79f95db47b4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", "\[Rule]", 
   FractionBox["1", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "kappa"}], ")"}]}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.997084571950461*^9, 3.997084591252471*^9}, 
   3.997084753766035*^9},
 CellLabel->
  "Out[1792]=",ExpressionUUID->"8ef5f1a4-455a-4938-b109-0646241bb3f5"],

Cell[BoxData[
 RowBox[{"2", " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", "kappa"}], ")"}]}]], "Output",
 CellChangeTimes->{{3.997084571950461*^9, 3.997084591252471*^9}, 
   3.997084753766605*^9},
 CellLabel->
  "Out[1793]=",ExpressionUUID->"55734237-1371-47ee-badc-144d1992e66c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"x", "/.", " ", "sing"}], ",", " ", "kappa"}], "]"}], " ", "//", 
  " ", "Simplify"}]], "Input",
 CellChangeTimes->{{3.997084587516427*^9, 3.99708458819385*^9}},
 CellLabel->
  "In[1794]:=",ExpressionUUID->"d98c8241-f05c-41a4-be43-feaffafaeb85"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox["1", 
   RowBox[{"2", " ", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "+", "kappa"}], ")"}], "2"]}]]}]], "Output",
 CellChangeTimes->{{3.9970845886968517`*^9, 3.997084591263567*^9}, 
   3.9970847537695293`*^9},
 CellLabel->
  "Out[1794]=",ExpressionUUID->"0c217510-d947-4162-89ff-a2c674b665d6"]
}, Open  ]],

Cell["\<\
Here kappa stands for \[Kappa]. The singular phenotype is convergence \
unstable because J > 0. It is a threshold: populations below it evolve \
towards x = 0, whereas populations above it evolve towards x = 1.\
\>", "Text",ExpressionUUID->"90abc7f7-994e-4bc6-8d98-6c3b2e02d273"],

Cell["\<\
Increasing adult survival, decreasing dispersal and decreasing patch size \
increase \[Kappa], so the threshold falls. The positive effect of hunting on \
a partner then receives more weight, allowing coordinated hunting to evolve \
from a lower initial x.\
\>", "Text",ExpressionUUID->"0adbd23a-1840-4389-9dc0-d66e19ee6bac"],

Cell["\<\
When s = 0 or m = 1, \[Kappa] = 0 and the threshold is x = 1/2. The \
directional result assumes m > 0 and s < 1; at m = 0 or s = 1, the factor \
multiplying the reduced gradient is zero.\
\>", "Text",ExpressionUUID->"33b11fc2-8567-4bf5-80ea-729e2a13086b"],

Cell[CellGroupData[{

