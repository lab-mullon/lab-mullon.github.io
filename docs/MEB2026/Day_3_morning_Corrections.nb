  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zbar1", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"zF", " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", " ", "-", " ", "2"}], ")"}], " ", "x"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"n", " ", "-", " ", "1"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zbarR", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"zF", " ", "+", " ", "z1", " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"n", " ", "-", " ", "3"}], ")"}], " ", "x"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{"n", " ", "-", " ", "1"}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
