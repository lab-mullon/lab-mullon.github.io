          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "1"}], "+", "s"}], ")"}]}]}], ")"}]}], "+", "s"}]], 
    " ", 
    FractionBox[
     RowBox[{"(", 
      RowBox[{"1", "-", "s"}], ")"}], 
     RowBox[{
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "x"}], "]"}], " "}]], 
    RowBox[{"(", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        FractionBox["V", "2"], "-", 
        RowBox[{"Cc", " ", "x"}]}], ")"}], "+", 
      RowBox[{"\[Kappa]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          FractionBox["V", "2"]}], "-", 
         RowBox[{"Cc", " ", "x"}]}], ")"}]}]}], " ", ")"}]}]}], "  ", "//", 
  "FullSimplify"}]], "Input",
 CellChangeTimes->{{3.997082652686989*^9, 3.997082697132992*^9}, {
  3.997082776875059*^9, 3.9970827778369923`*^9}},
 CellLabel->
  "In[1766]:=",ExpressionUUID->"76bdeac8-56e2-47f7-b509-5c432331a9ee"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.997082693753037*^9, 3.997082702416277*^9}, 
   3.9970827789022627`*^9, 3.997082975021089*^9, 3.997084591094612*^9, 
   3.997084753618639*^9},
 CellLabel->
  "Out[1766]=",ExpressionUUID->"6c5b6cbd-afe0-478b-89ee-399a1d5ff2a7"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"Sreduced", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      FractionBox["V", "2"], "-", 
      RowBox[{"Cc", " ", "x"}]}], ")"}], "+", 
    RowBox[{"kappa", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["V", "2"]}], "-", 
       RowBox[{"Cc", " ", "x"}]}], ")"}]}]}]}], " ", ";"}]], "Input",
 CellChangeTimes->{{3.9970827328344307`*^9, 3.9970827421164827`*^9}, {
  3.997083029538002*^9, 3.997083029969151*^9}},
 CellLabel->
  "In[1767]:=",ExpressionUUID->"46c02e93-1ba2-4fd6-84f4-598995658545"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sing", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{"Sreduced", " ", "==", " ", "0"}], ",", " ", "x"}], "]"}]}]}], 
  " "}], "\n", 
 RowBox[{"J", " ", "=", " ", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{"Sreduced", ",", " ", "x"}], "]"}], " ", "//", " ", "Simplify", 
   " "}]}]}], "Input",
 CellChangeTimes->{{3.9970827497114162`*^9, 3.997082754297943*^9}, {
  3.9970830017561817`*^9, 3.9970830050373383`*^9}},
 CellLabel->
  "In[1768]:=",ExpressionUUID->"99b4b81b-8007-426f-a8e9-e0647993c838"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", "\[Rule]", 
   FractionBox[
    RowBox[{"V", "-", 
     RowBox[{"kappa", " ", "V"}]}], 
    RowBox[{"2", " ", "Cc", " ", 
     RowBox[{"(", 
      RowBox[{"1", "+", "kappa"}], ")"}]}]]}], "}"}]], "Output",
 CellChangeTimes->{{3.997083005269059*^9, 3.9970830332146463`*^9}, 
   3.9970845911096563`*^9, 3.9970847536299353`*^9},
 CellLabel->
  "Out[1768]=",ExpressionUUID->"b1a2ca07-f71b-4173-8dc9-109baa044e68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "Cc"}], " ", 
  RowBox[{"(", 
   RowBox[{"1", "+", "kappa"}], ")"}]}]], "Output",
 CellChangeTimes->{{3.997083005269059*^9, 3.9970830332146463`*^9}, 
   3.9970845911096563`*^9, 3.997084753630664*^9},
 CellLabel->
  "Out[1769]=",ExpressionUUID->"c98ec169-c342-4e99-b8c1-b81ba7a12f04"]
}, Open  ]],

Cell["\<\
Here kappa stands for \[Kappa]. The singular phenotype is convergence stable \
because J < 0. Increasing \[Kappa] lowers evolved aggressivity.\
\>", "Text",
 CellChangeTimes->{{3.9970830411910133`*^9, 
  3.997083055769842*^9}},ExpressionUUID->"e9238bfa-a9c1-4ef9-9a14-\
57dc03577f43"],

Cell["\<\
This is an interior singular phenotype when V (1 - \[Kappa]) < 2 C (1 + \
\[Kappa]). If the expression exceeds one, selection instead leads to the \
boundary x = 1.\
\>", "Text",ExpressionUUID->"51d0db56-a26a-4995-9db7-6fea81a49e3f"],

Cell["\<\
The net social weight \[Kappa] increases with adult survival and decreases \
with dispersal and patch size. Longer adult survival, less dispersal and \
smaller patches therefore favour lower aggressivity. When s = 0, \[Kappa] = 0 \
even if relatedness is positive: local competition exactly cancels the \
relatedness effect.\
\>", "Text",ExpressionUUID->"eb13617c-de66-4f0e-8cf0-846e75d582c1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", " ", 
    RowBox[{
     RowBox[{"\[Kappa]", " ", "/.", 
      RowBox[{"n", "->", "10"}]}], " ", "/.", " ", 
     RowBox[{"s", "->", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0.5", ",", "0.9"}], "}"}]}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"m", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"m", ",", "\"\<\[Kappa]\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.997084686506791*^9, 3.997084741148212*^9}},
