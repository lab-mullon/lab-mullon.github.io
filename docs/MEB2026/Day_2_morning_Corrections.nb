  "Out[798]=",ExpressionUUID->"06b5f2d3-5526-42ca-86df-b54089a625a6"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", "z_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"6", " ", "z"}], "5"], "-", 
    FractionBox[
     SuperscriptBox["z", "2"], "5"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Cc", "[", "z_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"11", " ", "z"}], "10"], "-", 
    FractionBox[
     RowBox[{"3", " ", 
      SuperscriptBox["z", "2"]}], "10"]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"B", "[", 
     RowBox[{"y", "+", "x"}], "]"}], "-", 
    RowBox[{"Cc", "[", "y", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"f0", "+", 
    RowBox[{"\[Delta]", " ", 
     RowBox[{"P", "[", 
      RowBox[{"y", ",", "x"}], "]"}]}]}]}], ";"}]}], "Input",
