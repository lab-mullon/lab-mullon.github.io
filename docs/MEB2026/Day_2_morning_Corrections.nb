Cell["\<\
The singular strategy xstar = 1/2 is convergence stable when 0 <= cf < 1/2. \
At cf = 1/2, the selection gradient vanishes for every resident phenotype.\
\>", "Text",ExpressionUUID->"6c1d5015-fcdf-4cc4-a36c-316e87df51e7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"\[Rho]", ",", "y", ",", "y"}], "]"}], "/.", 
      "\[VeryThinSpace]", 
      RowBox[{"y", "\[Rule]", "x"}]}], "/.", "\[VeryThinSpace]", "sing"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"%", " ", 
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "x"}], "]"}]}], "/.", "\[VeryThinSpace]", "sing"}], 
  "]"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.99707121000653*^9, 3.9970712135928926`*^9}, {
  3.99707369062479*^9, 3.9970736989453363`*^9}},
 CellLabel->
  "In[792]:=",ExpressionUUID->"14a9f303-3460-436f-8924-b8360a9ad4b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "2"}], " ", "cf", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", "\[Delta]"}]], "Output",
 CellChangeTimes->{3.997070884980796*^9, 3.9970712151391497`*^9, 
  3.997071305389986*^9, 3.997073699415699*^9, 3.99707400456814*^9},
 CellLabel->
  "Out[793]=",ExpressionUUID->"cd232fa1-21bb-420c-8c7e-1833603798bc"]
}, Open  ]],

Cell["\<\
The Hessian is positive when cf > 0. The singular strategy is therefore an \
evolutionary branching point when 0 < cf < 1/2.\
\>", "Text",ExpressionUUID->"f7b2b14b-1a7c-411e-b131-e081b135f586"],

Cell["\<\
Intermediate individuals pay the largest flexibility cost. Selection can \
therefore favour two more consistent behavioural types, one mostly docile and \
the other mostly aggressive.\
\>", "Text",ExpressionUUID->"ba703b10-2585-454b-9040-b756f188a6a2"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exercise 4: cooperative defence", "Section",ExpressionUUID->"b732f5e8-5282-474a-8b82-0cd45345f280"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
