Cell[CellGroupData[{

Cell["g. Is intermediate aggressivity uninvadable?", "Subsection",ExpressionUUID->"a484dc86-bac2-4ccd-9d6e-bef698ed99cc"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.997073563001335*^9},
 CellLabel->
  "In[775]:=",ExpressionUUID->"106034bf-bcda-4e58-954b-737a3e01b96c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", "x"}], "2"], "+", 
    RowBox[{"y", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "-", "x"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"f0", "+", 
    RowBox[{"\[Delta]", " ", 
     RowBox[{"P", "[", 
      RowBox[{"y", ",", "x"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{"s", "+", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "s"}], ")"}], " ", 
      RowBox[{"f", "[", 
       RowBox[{"y", ",", "x"}], "]"}]}], 
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "x"}], "]"}]]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xstar", "=", 
   FractionBox["1", "2"]}], ";"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.997073569137445*^9},
 CellLabel->
  "In[776]:=",ExpressionUUID->"85eaff59-979a-48e9-868a-5f969d1f95fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"rhoAtSing", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"\[Rho]", "/.", "\[VeryThinSpace]", 
    RowBox[{"x", "\[Rule]", "xstar"}]}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.997073575418682*^9},
 CellLabel->
  "In[780]:=",ExpressionUUID->"b6a716ab-0e3a-4b77-bab9-82e93302e50c"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.997070829694647*^9, 3.997071201691002*^9, 
  3.9970713052934*^9, 3.99707400450459*^9},
 CellLabel->
  "Out[780]=",ExpressionUUID->"b81d4cfb-bbc3-423c-bf46-2d2303cead5d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{"rhoAtSing", "\[Equal]", "1"}], "]"}]], "Input",
