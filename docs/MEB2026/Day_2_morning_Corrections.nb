Cell[BoxData[
 RowBox[{"\[Rho]", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"s", "+", 
    FractionBox[
     RowBox[{"f", "[", 
      RowBox[{"y", ",", "x"}], "]"}], 
     RowBox[{"1", "+", 
      RowBox[{"\[Gamma]", " ", "Nhat"}]}]]}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997073832945541*^9, 3.997073840236718*^9}},
 CellLabel->
  "In[806]:=",ExpressionUUID->"1052b5ab-4d46-4ddc-97c4-ef9bf81e3664"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"10", " ", "f0"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"3", " ", "s"}]}], ")"}], " ", 
         SuperscriptBox["x", "2"]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", "y", " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", "y"}], ")"}]}], "+", 
      RowBox[{"x", " ", 
       RowBox[{"(", 
        RowBox[{"12", "+", "s", "-", 
         RowBox[{"4", " ", "y"}], "+", 
         RowBox[{"4", " ", "s", " ", "y"}]}], ")"}]}]}], ")"}], " ", 
    "\[Delta]"}]}], 
  RowBox[{
   RowBox[{"10", " ", "f0"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"13", "-", 
      RowBox[{"5", " ", "x"}]}], ")"}], " ", "x", " ", 
    "\[Delta]"}]}]]], "Output",
 CellChangeTimes->{
  3.997071038277519*^9, 3.9970712490121517`*^9, 3.997071305457181*^9, 
   3.997073841672022*^9, {3.997073975913434*^9, 3.997074004609599*^9}},
 CellLabel->
  "Out[806]=",ExpressionUUID->"a95a3e89-6609-46ff-ade2-8065c33c7a5e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Simplify", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"\[Rho]", "/.", "\[VeryThinSpace]", 
     RowBox[{"y", "\[Rule]", "x"}]}], ")"}], "\[Equal]", "1"}], 
  "]"}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.997073849253437*^9},
 CellLabel->
  "In[807]:=",ExpressionUUID->"5ace8a9f-8a82-41f9-a471-da18af3aff95"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  3.997071045154166*^9, 3.997071252458493*^9, 3.997071305460082*^9, 
   3.997073850063094*^9, {3.997073975923354*^9, 3.997074004620041*^9}},
 CellLabel->
  "Out[807]=",ExpressionUUID->"1132433f-a211-41f5-a475-54435b7500c8"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["b. Gradual evolution", "Subsection",ExpressionUUID->"c9540167-5688-481e-aa8d-0fb1c69bb24c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"S", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"\[Rho]", ",", "y"}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"y", "\[Rule]", "x"}]}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997073857650172*^9, 3.99707386570642*^9}},
 CellLabel->
  "In[808]:=",ExpressionUUID->"2f60fa4c-086d-435f-b782-7a1c65214543"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     RowBox[{"2", " ", "x"}]}], ")"}], " ", "\[Delta]"}], 
  RowBox[{
   RowBox[{"10", " ", "f0"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"13", "-", 
      RowBox[{"5", " ", "x"}]}], ")"}], " ", "x", " ", 
    "\[Delta]"}]}]]], "Output",
 CellChangeTimes->{
  3.997071056086046*^9, 3.997071253809924*^9, 3.9970713054748907`*^9, 
   3.997073867152*^9, {3.997073975929215*^9, 3.9970740046232233`*^9}},
 CellLabel->
  "Out[808]=",ExpressionUUID->"12194fc1-bca5-4eb6-9d99-2c075ed8078f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"selectionTerm", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"B", "[", 
         RowBox[{"y", "+", "x"}], "]"}], "-", 
        RowBox[{"Cc", "[", "y", "]"}]}], ")"}], ",", "y"}], "]"}], "/.", 
    "\[VeryThinSpace]", 
    RowBox[{"y", "\[Rule]", "x"}]}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997071256584296*^9, 3.997071257886047*^9}, {
  3.99707387783848*^9, 3.9970738987508917`*^9}},
 CellLabel->
  "In[809]:=",ExpressionUUID->"2993ab8f-42ea-49ef-97b6-65ddc6094241"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "10"], " ", 
  RowBox[{"(", 
   RowBox[{"1", "-", 
    RowBox[{"2", " ", "x"}]}], ")"}]}]], "Output",
 CellChangeTimes->{
  3.9970710571258173`*^9, 3.997071258444447*^9, 3.9970713054781027`*^9, 
   3.997073899173807*^9, {3.997073975939067*^9, 3.997074004626409*^9}},
 CellLabel->
  "Out[809]=",ExpressionUUID->"fa7063fa-27f7-498c-a48c-216dcbcd4823"]
}, Open  ]],

Cell["The sign of S is the sign of B'(2 x) - C'(x).", "Text",
 CellChangeTimes->{3.997071058864747*^9, 
  3.997073904135157*^9},ExpressionUUID->"85913cfb-4966-4451-bf3c-\
3a6480eeab1a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sing", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"S", "\[Equal]", "0"}], ",", "x"}], "]"}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.997073916821594*^9},
 CellLabel->
  "In[810]:=",ExpressionUUID->"6cba5b40-2bb9-4c5f-af16-f357af39feae"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", "\[Rule]", 
   FractionBox["1", "2"]}], "}"}]], "Output",
 CellChangeTimes->{
  3.9970710598121157`*^9, 3.997071268103533*^9, 3.997071305492298*^9, 
   3.9970739053718863`*^9, {3.997073975948564*^9, 3.9970740046314297`*^9}},
 CellLabel->
  "Out[810]=",ExpressionUUID->"75649f2e-4842-45bf-9e7a-27890426a234"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"J", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"S", ",", "x"}], "]"}], "/.", "\[VeryThinSpace]", "sing"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"%", " ", 
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "x"}], "]"}]}], "/.", "\[VeryThinSpace]", "sing"}], 
  "]"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997071277794039*^9, 3.997071290708457*^9}, {
  3.9970739234504766`*^9, 3.99707392906546*^9}},
 CellLabel->
  "In[811]:=",ExpressionUUID->"1e4d42c4-ef01-44a2-a343-9ee588eff738"],

Cell[BoxData[
 RowBox[{
  FractionBox["1", "5"], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", "\[Delta]"}]], "Output",
 CellChangeTimes->{
  3.9970710611600246`*^9, {3.99707126984781*^9, 3.997071305502821*^9}, {
   3.99707390835441*^9, 3.9970739296533823`*^9}, {3.997073975953628*^9, 
   3.997074004643393*^9}},
 CellLabel->
  "Out[812]=",ExpressionUUID->"8f372147-6986-403d-a8d7-246680ccd075"]
}, Open  ]],

Cell["\<\
The singular phenotype is xstar = 1/2. Since J is negative, it is convergence \
stable.\
\>", "Text",ExpressionUUID->"1c284c69-9e90-41f1-b3e0-4ea0f3526055"]
}, Open  ]],

Cell[CellGroupData[{

Cell["c. Selection at the singular phenotype", "Subsection",ExpressionUUID->"e0c058d2-5d04-49f8-8cad-84766b83af4c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"curvatureTerm", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"B", "[", 
         RowBox[{"y", "+", "x"}], "]"}], "-", 
        RowBox[{"Cc", "[", "y", "]"}]}], ",", "y", ",", "y"}], "]"}], "/.", 
     "\[VeryThinSpace]", 
     RowBox[{"y", "\[Rule]", "x"}]}], "/.", "\[VeryThinSpace]", "sing"}], 
   "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{
  3.997071072109125*^9, {3.9970739372117453`*^9, 3.997073981177297*^9}},
 CellLabel->
  "In[813]:=",ExpressionUUID->"661911c0-7487-4c4f-8b1c-e15b13d67a28"],

Cell[BoxData[
 FractionBox["1", "5"]], "Output",
 CellChangeTimes->{
  3.997071072819374*^9, {3.9970712944173603`*^9, 3.9970713055086823`*^9}, {
   3.997073963823995*^9, 3.9970740046533413`*^9}},
 CellLabel->
  "Out[813]=",ExpressionUUID->"80fb713d-eeec-4d78-b5ce-bad78ca81fba"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"H", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{"\[Rho]", ",", "y", ",", "y"}], "]"}], "/.", 
      "\[VeryThinSpace]", 
      RowBox[{"y", "\[Rule]", "x"}]}], "/.", "\[VeryThinSpace]", "sing"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{"%", " ", 
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "x"}], "]"}]}], "/.", "\[VeryThinSpace]", "sing"}], 
  "]"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997071299949437*^9, 3.997071303445191*^9}, {
  3.9970739960563498`*^9, 3.99707400234352*^9}},
 CellLabel->
  "In[814]:=",ExpressionUUID->"c0ac9ac0-2e99-43d0-9e0b-83416e6fb9ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", 
   FractionBox["1", "5"]}], " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", "\[Delta]"}]], "Output",
 CellChangeTimes->{{3.997071303985489*^9, 3.997071305517115*^9}, {
  3.997073975967651*^9, 3.997074004656475*^9}},
 CellLabel->
  "Out[815]=",ExpressionUUID->"f340665e-b405-4047-8704-02f3a2dc4977"]
}, Open  ]],

Cell["\<\
The curvature B''(2 xstar) - C''(xstar) is positive, so H is positive. \
Selection is disruptive and xstar is an evolutionary branching point.\
\>", "Text",ExpressionUUID->"899e013e-6ed2-424b-8f0f-fada4aff6f8f"],

Cell["\<\
The population can diversify into individuals investing little in defence and \
individuals investing strongly in defence.\
\>", "Text",ExpressionUUID->"832de23a-b28e-4dc8-b9e4-63f288c16577"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
