}, Open  ]],

Cell["\<\
Every mutant has invasion fitness one at the singular strategy. The fitness \
landscape is flat and mutants have no selective advantage.\
\>", "Text",ExpressionUUID->"df48e52a-ba97-4e4f-8ddc-be5f0984ae4a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"H", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"\[Rho]", ",", " ", "y", ",", " ", "y"}], "]"}], " ", "/.", " ", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", " ", "->", " ", "xstar"}], ",", " ", 
      RowBox[{"x", " ", "->", " ", "xstar"}]}], "}"}]}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997073584793315*^9, 3.9970735896799192`*^9}},
 FormatType->"InputForm",
 CellLabel->
  "In[782]:=",ExpressionUUID->"535e63ee-72b2-464c-a6e4-f94b00d5fbe0"],

Cell[BoxData["0"], "Output",
 CellChangeTimes->{3.997070832032309*^9, 3.997071201704715*^9, 
  3.997071305307502*^9, 3.9970740045195007`*^9},
 CellLabel->
  "Out[782]=",ExpressionUUID->"3926ed9e-baed-4133-b62d-f6ad05afef8f"]
}, Open  ]],

Cell["\<\
H is zero, so selection at the singular strategy is neither stabilising \
(because there are no higher order terms).\
\>", "Text",
 CellChangeTimes->{{3.99707086410008*^9, 
  3.997070876789858*^9}},ExpressionUUID->"410eae4a-b3d5-4b4e-900d-\
c300931fa5b7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["h. Cost of behavioural flexibility", "Subsection",ExpressionUUID->"5dcfaff8-365f-4b33-aa30-336f142109d7"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.997073596411927*^9},
 CellLabel->
  "In[783]:=",ExpressionUUID->"ae3703ac-3084-48cf-b902-efc8534a12a3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"1", "-", "x"}], "2"], "+", 
    RowBox[{"y", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "-", "x"}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"f0", "+", 
    RowBox[{"\[Delta]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"P", "[", 
        RowBox[{"y", ",", "x"}], "]"}], "-", 
       RowBox[{"cf", " ", "y", " ", 
        RowBox[{"(", 
         RowBox[{"1", "-", "y"}], ")"}]}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{"s", "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "s"}], ")"}], 
     FractionBox[
      RowBox[{" ", 
       RowBox[{"f", "[", 
        RowBox[{"y", ",", "x"}], "]"}]}], 
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "x"}], "]"}]]}]}]}], ";"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997070898257498*^9, 3.997070898780686*^9}, {
  3.997073600785499*^9, 3.997073607342955*^9}},
 CellLabel->
  "In[784]:=",ExpressionUUID->"3660e550-1f67-433a-92e6-118c38137af8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"S", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"\[Rho]", ",", "y"}], "]"}], "/.", "\[VeryThinSpace]", 
     RowBox[{"y", "\[Rule]", "x"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Simplify", "[", 
  RowBox[{"S", "\[Equal]", 
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "-", "s"}], ")"}], " ", "\[Delta]", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"2", " ", "cf"}]}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", "2"], "-", "x"}], ")"}]}], 
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "x"}], "]"}]]}], "]"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997073615326676*^9, 3.9970736602032757`*^9}},
 CellLabel->
  "In[787]:=",ExpressionUUID->"3ff63438-66b7-4524-9946-60a6d1f53ad7"],

Cell[BoxData["True"], "Output",
