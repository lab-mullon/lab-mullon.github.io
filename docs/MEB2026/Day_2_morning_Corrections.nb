Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"residentRecursion", "=", 
   RowBox[{"Nt1", "\[Equal]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"s", "+", 
       FractionBox[
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "x"}], "]"}], 
        RowBox[{"1", "+", 
