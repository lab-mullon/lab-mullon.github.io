Cell[CellGroupData[{

Cell["a. Invasion fitness", "Subsection",ExpressionUUID->"eec72265-628e-49d1-82b4-fb3397419165"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Pgeneral", "=", 
   RowBox[{
    RowBox[{"B", "[", 
     RowBox[{"y", "+", "x"}], "]"}], "-", 
    RowBox[{"Cc", "[", "y", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"payoffGradient", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"Pgeneral", ",", "y"}], "]"}], "/.", "\[VeryThinSpace]", 
     RowBox[{"y", "\[Rule]", "x"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"payoffCurvature", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"Pgeneral", ",", "y", ",", "y"}], "]"}], "/.", 
     "\[VeryThinSpace]", 
     RowBox[{"y", "\[Rule]", "x"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"payoffGradient", ",", "payoffCurvature"}], "}"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{
  3.99707102809881*^9, {3.997073710719406*^9, 3.997073726323194*^9}},
 CellLabel->
  "In[795]:=",ExpressionUUID->"f2d8402f-be91-4a02-badc-6968400245a2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["B", "\[Prime]",
      MultilineFunction->None], "[", 
     RowBox[{"2", " ", "x"}], "]"}], "-", 
    RowBox[{
     SuperscriptBox["Cc", "\[Prime]",
      MultilineFunction->None], "[", "x", "]"}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox["B", "\[Prime]\[Prime]",
      MultilineFunction->None], "[", 
     RowBox[{"2", " ", "x"}], "]"}], "-", 
    RowBox[{
     SuperscriptBox["Cc", "\[Prime]\[Prime]",
      MultilineFunction->None], "[", "x", "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{{3.997070998280807*^9, 3.9970710314468946`*^9}, 
