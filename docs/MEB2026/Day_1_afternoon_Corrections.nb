Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox["1", 
    RowBox[{"2", " ", "C"}]], ",", 
   RowBox[{"-", 
    FractionBox["V", 
     RowBox[{"2", " ", 
      SuperscriptBox["C", "2"]}]]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.997069138117275*^9, {3.9970742863299847`*^9, 3.997074292403448*^9}, {
