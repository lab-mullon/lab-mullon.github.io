Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"residentRecursion", "=", 
   RowBox[{"Nt1", "\[Equal]", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"s", "+", 
       FractionBox[
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "x"}], "]"}], 
        RowBox[{"1", "+", 
         RowBox[{"\[Gamma]", " ", "Nt"}]}]]}], ")"}], " ", "Nt"}]}]}], 
  ";"}], "\n", 
 RowBox[{"equilibria", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"residentRecursion", "/.", "\[VeryThinSpace]", 
      RowBox[{"Nt1", "\[Rule]", "Nt"}]}], ",", "Nt"}], "]"}], 
   "]"}]}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.99707485427888*^9},
