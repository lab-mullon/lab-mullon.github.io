 CellLabel->
  "Out[1137]=",ExpressionUUID->"3b157185-d555-41be-bc23-5c01e7296536"]
}, Open  ]],

Cell["\<\
A more valuable resource increases evolved aggressivity, whereas a larger \
fighting cost decreases it.\
\>", "Text",ExpressionUUID->"c282647a-e0fc-4d6c-bba4-9bcdc2ed363a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]", "-", "1"}], " ", "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{"D", "[", 
  RowBox[{"%", ",", "s"}], "]"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997074439492577*^9, 3.9970744541172457`*^9}, {
  3.997074562005129*^9, 3.997074588566667*^9}},
 CellLabel->
  "In[1138]:=",ExpressionUUID->"71d9e2e7-da60-4c73-883d-5106f57d0ec5"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"V", "-", 
     RowBox[{"2", " ", "C", " ", "x"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"x", "-", "y"}], ")"}], " ", "\[Delta]"}], 
  RowBox[{
   RowBox[{"2", " ", "f0"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"V", "-", 
      RowBox[{"2", " ", "C", " ", 
       SuperscriptBox["x", "2"]}]}], ")"}], " ", "\[Delta]"}]}]]], "Output",
 CellChangeTimes->{
  3.9970691381246223`*^9, 3.997074292413856*^9, {3.997074420563686*^9, 
   3.997074456677225*^9}, {3.997074529227705*^9, 3.997074591015293*^9}, 
   3.997074823213826*^9, 3.997075162744721*^9},
 CellLabel->
  "Out[1138]=",ExpressionUUID->"de85cfd4-c45f-45b4-a1b9-6b655b2b5692"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"(", 
    RowBox[{"V", "-", 
     RowBox[{"2", " ", "C", " ", "x"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"x", "-", "y"}], ")"}], " ", "\[Delta]"}], 
  RowBox[{
   RowBox[{"2", " ", "f0"}], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"V", "-", 
      RowBox[{"2", " ", "C", " ", 
       SuperscriptBox["x", "2"]}]}], ")"}], " ", "\[Delta]"}]}]]], "Output",
 CellChangeTimes->{
  3.9970691381246223`*^9, 3.997074292413856*^9, {3.997074420563686*^9, 
   3.997074456677225*^9}, {3.997074529227705*^9, 3.997074591015293*^9}, 
   3.997074823213826*^9, 3.997075162745466*^9},
 CellLabel->
  "Out[1139]=",ExpressionUUID->"8d09ce35-404d-4016-a8eb-57b13d07f032"]
}, Open  ]],

Cell["\<\
Mutant growth rate is proportional to 1 - s. So higher survival weakens \
selection without changing its direction.\
\>", "Text",
 CellChangeTimes->{{3.99707464435533*^9, 
  3.997074663493626*^9}},ExpressionUUID->"4e6ca595-8b89-4cfa-b1a7-\
af7f101d1224"]
}, Open  ]],

Cell[CellGroupData[{

Cell["f. Evolution and population size", "Subsection",ExpressionUUID->"f6da8d50-adac-4752-96e0-f635029e6e4d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Nhat", "=", 
  RowBox[{"Simplify", "[", 
   FractionBox[
    RowBox[{
     FractionBox[
      RowBox[{"f", "[", 
       RowBox[{"x", ",", "x"}], "]"}], 
      RowBox[{"1", "-", "s"}]], "-", "1"}], "\[Gamma]"], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997074670456542*^9, 3.997074678029448*^9}},
 CellLabel->
  "In[1140]:=",ExpressionUUID->"d6c91b14-3fbc-4dd9-afc2-abc526edfdba"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"-", "2"}], "+", 
    RowBox[{"2", " ", "f0"}], "+", 
    RowBox[{"2", " ", "s"}], "+", 
    RowBox[{"V", " ", "\[Delta]"}], "-", 
    RowBox[{"2", " ", "C", " ", 
     SuperscriptBox["x", "2"], " ", "\[Delta]"}]}], 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", "\[Gamma]"}]]}]], "Output",
 CellChangeTimes->{
  3.9970691381365643`*^9, 3.99707429242702*^9, {3.997074420580801*^9, 
   3.9970744271763144`*^9}, 3.997074678510766*^9, 3.997074823223401*^9, 
   3.997075162749361*^9},
 CellLabel->
  "Out[1140]=",ExpressionUUID->"96e0cc52-301f-4625-824b-754306eb3c60"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"NhatPrime", "=", 
  RowBox[{"Factor", "[", 
   RowBox[{"D", "[", 
    RowBox[{"Nhat", ",", "x"}], "]"}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997074675733897*^9, 3.997074687779641*^9}},
 CellLabel->
  "In[1141]:=",ExpressionUUID->"283d8672-32be-41ec-9742-bb52b75a05b9"],

Cell[BoxData[
 FractionBox[
  RowBox[{"2", " ", "C", " ", "x", " ", "\[Delta]"}], 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", "\[Gamma]"}]]], "Output",
 CellChangeTimes->{
  3.9970691381392927`*^9, 3.997074292430312*^9, {3.997074420584302*^9, 
   3.9970744271811237`*^9}, 3.997074688384142*^9, 3.997074823229437*^9, 
   3.9970751627587852`*^9},
 CellLabel->
  "Out[1141]=",ExpressionUUID->"77ea6583-c941-4ec3-9e9e-d9c0bea82a28"]
}, Open  ]],

Cell["\<\
For x > 0, equilibrium population size decreases as aggressivity increases. \
So Starting below xstar, selection increases aggressivity while population \
size decreases.\
\>", "Text",
 CellChangeTimes->{{3.99707476932099*^9, 
  3.997074770297708*^9}},ExpressionUUID->"c8e7432b-8bda-4502-b7d0-\
27aac5ee89e1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"changeInPopulationSize", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Nhat", "/.", "\[VeryThinSpace]", 
      RowBox[{"x", "\[Rule]", "xstar"}]}], ")"}], "-", 
    RowBox[{"(", 
     RowBox[{"Nhat", "/.", "\[VeryThinSpace]", 
      RowBox[{"x", "\[Rule]", "0"}]}], ")"}]}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997074778646386*^9, 3.997074801544886*^9}},
 CellLabel->
  "In[1142]:=",ExpressionUUID->"1a938370-4d9d-4e47-84d7-49be75952dd1"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["V", "2"], " ", "\[Delta]"}], 
   RowBox[{
    RowBox[{"4", " ", "C", " ", "\[Gamma]"}], "-", 
    RowBox[{"4", " ", "C", " ", "s", " ", "\[Gamma]"}]}]]}]], "Output",
 CellChangeTimes->{
  3.9970691381640997`*^9, 3.997074292459852*^9, {3.99707442060023*^9, 
   3.9970744271973143`*^9}, {3.99707478510389*^9, 3.997074823237794*^9}, 
   3.997075162762508*^9},
 CellLabel->
  "Out[1142]=",ExpressionUUID->"03e91dfd-6531-4a6e-9b5f-00d75374f32e"]
}, Open  ]],

Cell["\<\
Selection favours individuals that gain more from contests against current \
residents. Mutual aggression lowers fecundity, so this individual advantage \
reduces population size.\
\>", "Text",ExpressionUUID->"9257ed58-b50d-4d9a-b02e-11f83c78be0b"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Exercise 3: cooperative hunting", "Section",ExpressionUUID->"84ff3477-e1f8-4aab-bae3-83c6440f501f"],

Cell["Clear[\"Global`*\"]", "Input",
 DefaultFormatType->InputForm,
 CellLabel->
  "In[1143]:=",ExpressionUUID->"2ebdd61d-c7db-4743-bcd7-d502dbd37e59"],

Cell[CellGroupData[{

Cell["a. Payoff, demography and invasion fitness", "Subsection",ExpressionUUID->"537adfae-a3b2-4f51-9589-108751a9d7ec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"payoffCC", "=", 
   RowBox[{"y", " ", "x", " ", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"payoffCS", "=", 
   RowBox[{"y", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}], " ", "0"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"payoffSC", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "y"}], ")"}], " ", "x"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"payoffSS", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", "y"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", "x"}], ")"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"P", "[", 
   RowBox[{"y_", ",", "x_"}], "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"payoffCC", "+", "payoffCS", "+", "payoffSC", "+", "payoffSS"}], 
   "]"}]}]}], "Input",
 DefaultFormatType->InputForm,
