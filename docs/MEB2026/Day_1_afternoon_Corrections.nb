Notebook[{

Cell[CellGroupData[{
Cell["Day 1 afternoon \[LongDash] corrections", "Chapter",
 CellChangeTimes->{{3.997070731139502*^9, 
  3.9970707376787853`*^9}},ExpressionUUID->"8fa7a2af-cc51-44f8-ab50-\
4af6e9f4087f"],

Cell[CellGroupData[{

Cell["Exercise 1: selection on aggressivity", "Section",ExpressionUUID->"ae302b88-3f41-4706-9c1c-f155dd097c80"],

Cell[BoxData[
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.9970741761710377`*^9},
 CellLabel->
  "In[1124]:=",ExpressionUUID->"8a1d5a0e-f329-4496-87b2-eaa256af4825"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], " ", "V", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "x"}], ")"}]}], "+", 
    RowBox[{"y", " ", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["V", "2"], "-", 
       RowBox[{"C", " ", "x"}]}], ")"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"y_", ",", "x_"}], "]"}], ":=", 
   RowBox[{"f0", "+", 
    RowBox[{"\[Delta]", " ", 
     RowBox[{"P", "[", 
      RowBox[{"y", ",", "x"}], "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Rho]", "=", 
   RowBox[{"s", "+", 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "s"}], ")"}], " ", 
      RowBox[{"f", "[", 
       RowBox[{"y", ",", "x"}], "]"}]}], 
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "x"}], "]"}]]}]}], ";"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.9970741836803417`*^9, 3.997074188556443*^9}},
 CellLabel->
  "In[1125]:=",ExpressionUUID->"47a81c9c-2345-4a0d-a1b5-e7a530a8ed72"],

Cell[CellGroupData[{

Cell["d. Selection gradient", "Subsection",ExpressionUUID->"1cc76c2a-ed68-446a-ab37-99300cb246c3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"S", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{"\[Rho]", ",", "y"}], "]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"y", "\[Rule]", "x"}]}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.997074191162614*^9, 3.997074205748026*^9}},
 CellLabel->
  "In[1128]:=",ExpressionUUID->"e18c8789-afe9-4578-8d71-91f9f95dd9a1"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", 
    RowBox[{"(", 
     RowBox[{"V", "-", 
      RowBox[{"2", " ", "C", " ", "x"}]}], ")"}], " ", "\[Delta]"}], 
   RowBox[{
    RowBox[{"2", " ", "f0"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"V", "-", 
       RowBox[{"2", " ", "C", " ", 
        SuperscriptBox["x", "2"]}]}], ")"}], " ", "\[Delta]"}]}]]}]], "Output",\

 CellChangeTimes->{
  3.99706913802798*^9, 3.9970742063913393`*^9, 3.997074292351961*^9, {
   3.9970744204901667`*^9, 3.997074427035387*^9}, 3.997074536669263*^9, 
   3.997074823157874*^9, 3.997075162683444*^9},
 CellLabel->
  "Out[1128]=",ExpressionUUID->"5c4e6f03-55d7-445a-a6ce-18fb180d4555"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"selectionWhenLow", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{"S", ">", "0"}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.9970742087891912`*^9, 3.997074221030802*^9}, 
   3.997074806763753*^9},
 CellLabel->
  "In[1129]:=",ExpressionUUID->"ee8dd810-a82f-4581-9adb-b6a9a468a4b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"V", "-", 
     RowBox[{"2", " ", "C", " ", "x"}]}], ")"}], " ", "\[Delta]", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"2", " ", "f0"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"V", "-", 
        RowBox[{"2", " ", "C", " ", 
         SuperscriptBox["x", "2"]}]}], ")"}], " ", "\[Delta]"}]}], ")"}]}], 
  "<", "0"}]], "Output",
 CellChangeTimes->{
  3.997069138078968*^9, 3.997074222422358*^9, 3.997074292357031*^9, {
   3.997074420496786*^9, 3.9970744270919333`*^9}, 3.9970745367228737`*^9, {
   3.997074807170823*^9, 3.997074823163288*^9}, 3.997075162699704*^9},
 CellLabel->
  "Out[1129]=",ExpressionUUID->"0d723dda-17e6-4552-b1cc-80307364bbf5"]
}, Open  ]],

Cell["\<\
Selection favours increasing aggressivity below the threshold V/(2 C) and \
decreasing aggressivity above it.\
\>", "Text",ExpressionUUID->"5d096c2f-693e-4623-bbd7-1e5cb755c675"]
}, Open  ]],

Cell[CellGroupData[{

Cell["e. Gradual evolution", "Subsection",ExpressionUUID->"2665d2e6-8b15-47ff-aadb-fbbb0aa9ea1f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"sing", "=", 
  RowBox[{"Flatten", "[", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"S", "\[Equal]", "0"}], ",", "x"}], "]"}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.9970742289640913`*^9},
 CellLabel->
  "In[1130]:=",ExpressionUUID->"7232e0dd-185f-4240-9b7c-2574486974fc"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"x", "\[Rule]", 
   FractionBox["V", 
    RowBox[{"2", " ", "C"}]]}], "}"}]], "Output",
 CellChangeTimes->{
  3.997069138087122*^9, 3.997074292367957*^9, {3.997074420511633*^9, 
   3.997074427098933*^9}, 3.997074536735395*^9, 3.997074823175314*^9, 
   3.9970751627048473`*^9},
 CellLabel->
  "Out[1130]=",ExpressionUUID->"aa083bc0-a391-4dbb-80f7-46df59e2c258"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"xstar", "=", 
  RowBox[{"x", "/.", "\[VeryThinSpace]", "sing"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.997074233105843*^9},
 CellLabel->
  "In[1131]:=",ExpressionUUID->"5e32cf95-9d63-4dd7-8cef-954afce16e3d"],

Cell[BoxData[
 FractionBox["V", 
  RowBox[{"2", " ", "C"}]]], "Output",
 CellChangeTimes->{
  3.9970691380899553`*^9, 3.997074292371447*^9, {3.997074420523253*^9, 
   3.9970744271148252`*^9}, 3.997074536741701*^9, 3.997074823180544*^9, 
   3.997075162713791*^9},
 CellLabel->
  "Out[1131]=",ExpressionUUID->"be4b02ab-786e-4fba-856f-2d2cb75d9175"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"interiorCondition", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"0", "<", "xstar", "<", "1"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"V", ">", "0"}], ",", 
       RowBox[{"C", ">", "0"}]}], "}"}]}]}], "]"}]}]], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{3.997074237689424*^9},
 CellLabel->
  "In[1132]:=",ExpressionUUID->"8efcd48a-7df0-4a8b-8547-07565a565157"],

Cell[BoxData[
 RowBox[{"V", "<", 
  RowBox[{"2", " ", "C"}]}]], "Output",
 CellChangeTimes->{
  3.99706913810013*^9, 3.997074292381669*^9, {3.997074420531307*^9, 
   3.997074427126389*^9}, 3.997074536755558*^9, 3.9970748231926126`*^9, 
   3.997075162717456*^9},
 CellLabel->
  "Out[1132]=",ExpressionUUID->"840d364a-cfab-4194-b0bb-87f680e906cd"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"J", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"S", ",", "x"}], "]"}], "/.", "\[VeryThinSpace]", "sing"}], " ",
     "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"%", "*", " ", 
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "x"}], "]"}]}], "/.", "\[VeryThinSpace]", "sing"}], 
  " ", "//", "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"we", " ", "can", " ", "multiply", " ", "by", " ", 
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "x"}], "]"}]}], ">", 
    RowBox[{
    "0", " ", "to", " ", "make", " ", "expressions", " ", "look", " ", 
     "better"}]}], " ", "*)"}]}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.9970742435319233`*^9, 3.997074250383376*^9}, {
   3.997074372533136*^9, 3.997074425453017*^9}, 3.9970748155858603`*^9},
 CellLabel->
  "In[1133]:=",ExpressionUUID->"18199739-f4d7-4ddf-b56c-ee3f266e7d76"],

Cell[BoxData[
 RowBox[{"C", " ", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"-", "1"}], "+", "s"}], ")"}], " ", "\[Delta]"}]], "Output",
 CellChangeTimes->{
  3.997069138114211*^9, 3.997074251436282*^9, 3.997074292397765*^9, {
   3.9970743831987677`*^9, 3.997074427130929*^9}, 3.9970745367589684`*^9, 
   3.997074823204728*^9, 3.997075162726272*^9},
 CellLabel->
  "Out[1134]=",ExpressionUUID->"273fea1c-be69-4360-b84d-f41b6837640d"]
}, Open  ]],

Cell["\<\
J is negative, so the singular strategy is convergence stable.\
\>", "Text",ExpressionUUID->"b5a6c22d-318b-4cac-817d-29aaaf14a08f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"effectOfV", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"xstar", ",", "V"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"effectOfC", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"D", "[", 
     RowBox[{"xstar", ",", "C"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"effectOfV", ",", "effectOfC"}], "}"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.9970742610219173`*^9, 3.997074285938324*^9}},
 CellLabel->
