Cell[BoxData[
 RowBox[{"S", "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "y"], "\[Rho]"}], "/.", "\[VeryThinSpace]", 
    RowBox[{"y", "\[Rule]", "x"}]}], "]"}]}]], "Input",
