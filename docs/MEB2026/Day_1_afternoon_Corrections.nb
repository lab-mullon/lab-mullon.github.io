Cell[CellGroupData[{

Cell["c. Two evolutionary outcomes", "Subsection",ExpressionUUID->"854a07a7-6653-4ecf-a316-3065da2c587b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"NhatSolitary", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Nhat", "/.", "\[VeryThinSpace]", 
     RowBox[{"x", "\[Rule]", "0"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"NhatCooperative", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Nhat", "/.", "\[VeryThinSpace]", 
     RowBox[{"x", "\[Rule]", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"populationDifference", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"NhatCooperative", "-", "NhatSolitary"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
  "NhatSolitary", ",", "NhatCooperative", ",", "populationDifference"}], 
  "}"}]}], "Input",
 DefaultFormatType->InputForm,
 CellChangeTimes->{{3.99707494524439*^9, 3.997074952116282*^9}},
 CellLabel->
  "In[1159]:=",ExpressionUUID->"879a7771-d6bf-4d25-a5f4-0193c5f9d596"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"2", "+", "s"}], 
    RowBox[{"\[Gamma]", "-", 
     RowBox[{"s", " ", "\[Gamma]"}]}]], ",", 
   FractionBox[
    RowBox[{"3", "+", "s"}], 
    RowBox[{"\[Gamma]", "-", 
     RowBox[{"s", " ", "\[Gamma]"}]}]], ",", 
   FractionBox["1", 
    RowBox[{"\[Gamma]", "-", 
     RowBox[{"s", " ", "\[Gamma]"}]}]]}], "}"}]], "Output",
 CellChangeTimes->{
  3.997069138382382*^9, {3.9970744207227383`*^9, 3.997074427304214*^9}, 
   3.9970748233268127`*^9, 3.997074880642383*^9, 3.997074958902522*^9, 
   3.997075162857316*^9},
 CellLabel->
  "Out[1162]=",ExpressionUUID->"0ec3da92-931b-4708-958c-93288349adfe"]
}, Open  ]],

Cell["\<\
Completely cooperative hunting supports the larger population.\
\>", "Text",ExpressionUUID->"265e4b0e-6914-4038-baa2-73e08974fda4"],

Cell["\<\
For x < 1/2, selection drives the population towards solitary hunting. For x \
> 1/2, selection drives it towards cooperative hunting.\
\>", "Text",ExpressionUUID->"f06f5daf-d635-4905-af8d-6ca2d7295689"],

Cell["\<\
Cooperation succeeds only when the partner also cooperates. This positive \
frequency dependence makes xstar an evolutionary threshold and generates \
bistability.\
\>", "Text",ExpressionUUID->"bc19c5eb-534b-4a80-9a59-888ba21b30b8"]
}, Open  ]]
}, Open  ]]
}, Open  ]]
},
